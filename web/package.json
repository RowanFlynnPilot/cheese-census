{
  "name": "cheese-census-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/sync-data.mjs",
    "dev": "node scripts/sync-data.mjs --draft && vite",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.2",
    "leaflet": "^1.9.4",
    "pmtiles": "^4.5.0",
    "protomaps-leaflet": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.6.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  }
}
